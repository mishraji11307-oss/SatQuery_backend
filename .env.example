# SatQuery AI Environment Configuration

# Application
APP_NAME="SatQuery AI"
APP_ENV="development"
DEBUG=true
DEMO_MODE=true
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000

# Security & Authentication
SECRET_KEY="satquery-super-secret-key-change-in-production-sih26167"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# PostgreSQL (Production / Docker): postgresql+asyncpg://satquery_user:satquery_pass@localhost:5432/satquery_db
# SQLite (Local Dev / Fallback): sqlite+aiosqlite:///./storage/satquery.db
DATABASE_URL="sqlite+aiosqlite:///./storage/satquery.db"
DB_ECHO=false

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# File Storage & Uploads
STORAGE_DIR="./storage"
UPLOAD_DIR="./storage/uploads"
EVIDENCE_DIR="./storage/evidence"
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=["tif", "tiff", "png", "jpg", "jpeg", "jp2"]

# Geospatial & Remote Sensing Processing
DEFAULT_CRS="EPSG:4326"
REGISTRATION_METHOD="ecc"  # options: ecc, orb, sift
MAX_IMAGE_DIMENSION=4096
ENABLE_AUTO_REGISTRATION=true

# AI & Model Engine
MODEL_DEVICE="cpu"  # options: cpu, cuda
MODEL_CACHE_DIR="./storage/models"
MOCK_MODEL_LATENCY=0.5

# CORS & Integration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:5500", "http://127.0.0.1:8000", "http://localhost:5173", "*"]
